<?xml version="1.0" encoding="utf-8"?>

<Root>
	<window>
		<width>1080</width>
		<height>720</height>
	</window>
	
	<model id="A">
		
		<name>backpack</name>
		<path>models/backpack/backpack.obj</path>
		<flipUVs>false</flipUVs>

		<translatex>0</translatex>
		<translatey>0</translatey>
		<translatez>0</translatez>

		<scalex>1</scalex>
		<scaley>1</scaley>
		<scalez>1</scalez>

		<gradi>0.0</gradi>
		<rotatex>0.0</rotatex>
		<rotatey>0.0</rotatey>
		<rotatez>0.0</rotatez>
	</model>

	<model id="B">

		<name>f16</name>
		<path>models/f16/f16.obj</path>
		<flipUVs>true</flipUVs>

		<translatex>0</translatex>
		<translatey>0</translatey>
		<translatez>-5</translatez>

		<scalex>1</scalex>
		<scaley>1</scaley>
		<scalez>1</scalez>

		<gradi>0.0</gradi>
		<rotatex>0.0</rotatex>
		<rotatey>0.0</rotatey>
		<rotatez>0.0</rotatez>
	</model>


</Root>